{
  "name": "@evva/nest-mqtt",
  "version": "2.1.0",
  "description": "MQTT Broker client for Nest.js",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "author": "EVVA Sicherheitstechnologie GmbH",
  "license": "EVVA Software License",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evva-sfw/nest-mqtt.git"
  },
  "bugs": {
    "url": "https://github.com/evva-sfw/nest-mqtt/issues"
  },
  "keywords": [
    "nestjs",
    "auth",
    "client"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "fmt": "npm run lint:fix && npm run prettier:fix",
    "lint": "eslint -c eslint.config.ts ./src",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier \"**/*.{js,ts,jsx,tsx,cjs,cts,mjs,mts,vue,astro,css,scss,json}\" --check",
    "prettier:fix": "npm run prettier -- --write",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage --no-watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/vitest --runInBand",
    "test:e2e": "vitest run --config ./test/vitest-e2e.json --no-watch",
    "prepack": "npx nest build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "mqtt": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "aedes": "^1.1.2",
    "auto-changelog": "^2.5.0",
    "eslint": "^10.10.0",
    "typescript-eslint": "^8.70.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.1",
    "reflect-metadata": "^0.2.2",
    "release-it": "^21.0.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsc-watch": "7.2.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
